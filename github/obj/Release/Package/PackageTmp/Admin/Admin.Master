<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="Chocodelight_Website.Admin.AdminMaster" %>
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">لوحة التحكم — Choco Delight</asp:ContentPlaceHolder></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin" />
    <link href="https://fonts.googleapis.com/css2?family=El+Messiri:wght@500;600;700&amp;family=Almarai:wght@400;700&amp;family=Outfit:wght@300;400;500;600&amp;display=swap" rel="stylesheet" />
    <link href="<%= Chocodelight_Website.Helpers.CultureHelper.Asset(this, "~/assets/css/site.css") %>" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
    <asp:ScriptManager ID="sm" runat="server" />

    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="ic-hex" viewBox="0 0 100 100"><polygon class="motif" points="50,4 90,27 90,73 50,96 10,73 10,27"/><polygon class="motif" points="50,16 79,33 79,67 50,84 21,67 21,33" opacity=".6"/></symbol>
      <symbol id="ic-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.6"/><path d="M4.5 20c1.6-4 5-5.6 7.5-5.6s5.9 1.6 7.5 5.6"/></symbol>
      <symbol id="ic-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7.5" height="7.5" rx="1"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1"/></symbol>
      <symbol id="ic-receipt" viewBox="0 0 24 24"><path d="M5 2v20l2.5-1.5L10 22l2.5-1.5L15 22l2.5-1.5L20 22V2H5z"/><path d="M8 7h8M8 11h8M8 15h5"/></symbol>
      <symbol id="ic-box" viewBox="0 0 24 24"><path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 7v10l9 4 9-4V7"/><path d="M12 11v10"/></symbol>
      <symbol id="ic-tag" viewBox="0 0 24 24"><path d="M12 2 2 12l10 10 10-10z"/><circle cx="12" cy="7" r="1.3"/></symbol>
      <symbol id="ic-mail" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M3 6l9 6 9-6"/></symbol>
      <symbol id="ic-logout" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></symbol>
      <symbol id="ic-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></symbol>
      <symbol id="ic-cash" viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="1"/><circle cx="12" cy="12" r="3"/></symbol>
      <symbol id="ic-edit" viewBox="0 0 24 24"><path d="M4 20h4l10.5-10.5a2 2 0 0 0 0-2.8l-1.2-1.2a2 2 0 0 0-2.8 0L4 16v4z"/></symbol>
      <symbol id="ic-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4.3-4.3"/></symbol>
      <symbol id="ic-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
      <symbol id="ic-arrow-back" viewBox="0 0 24 24"><path d="M19 12H5M11 6l-6 6 6 6"/></symbol>
      <symbol id="ic-check" viewBox="0 0 24 24"><path d="M4 12l5 5L20 6"/></symbol>
    </svg>

    <section class="admin-section">
      <div class="wrap admin-shell">
        <aside class="admin-sidebar">
          <div class="admin-sidebar-user">
            <div class="admin-sidebar-avatar"><svg viewBox="0 0 24 24"><use href="#ic-user"/></svg></div>
            <div>
              <div class="admin-sidebar-name"><asp:Literal ID="litAdminName" runat="server" /></div>
              <div class="admin-sidebar-role">مدير النظام</div>
            </div>
          </div>
          <nav class="admin-nav" aria-label="Admin navigation">
            <a href="<%= ResolveUrl("~/Admin/Default.aspx") %>" class='admin-nav-link <%= Active("Default") %>'>
              <svg viewBox="0 0 24 24"><use href="#ic-grid"/></svg><span>لوحة التحكم</span>
            </a>
            <a href="<%= ResolveUrl("~/Admin/Orders.aspx") %>" class='admin-nav-link <%= Active("Orders") %>'>
              <svg viewBox="0 0 24 24"><use href="#ic-receipt"/></svg><span>إدارة الطلبات</span>
            </a>
            <a href="<%= ResolveUrl("~/Admin/Products.aspx") %>" class='admin-nav-link <%= Active("Products") %>'>
              <svg viewBox="0 0 24 24"><use href="#ic-box"/></svg><span>إدارة المنتجات</span>
            </a>
            <a href="<%= ResolveUrl("~/Admin/Categories.aspx") %>" class='admin-nav-link <%= Active("Categories") %>'>
              <svg viewBox="0 0 24 24"><use href="#ic-tag"/></svg><span>التصنيفات</span>
            </a>
            <a href="<%= ResolveUrl("~/Admin/Messages.aspx") %>" class='admin-nav-link <%= Active("Messages") %>'>
              <svg viewBox="0 0 24 24"><use href="#ic-mail"/></svg><span>رسائل الاتصال</span>
            </a>
          </nav>
          <div class="admin-sidebar-logout">
            <a href="<%= ResolveUrl("~/Admin/Logout.ashx") %>" class="admin-nav-link">
              <svg viewBox="0 0 24 24"><use href="#ic-logout"/></svg><span>تسجيل الخروج</span>
            </a>
          </div>
          <a href="<%= ResolveUrl("~/Default.aspx") %>" class="admin-sidebar-back">الرجوع للموقع الرئيسي</a>
        </aside>

        <main class="admin-main">
          <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>
      </div>
    </section>

    <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />
    </form>
</body>
</html>
