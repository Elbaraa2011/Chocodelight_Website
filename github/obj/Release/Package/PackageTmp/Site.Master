<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Chocodelight_Website.SiteMaster" %>
<!DOCTYPE html>
<html lang="<%= Chocodelight_Website.Helpers.CultureHelper.HtmlLang %>" dir="<%= Chocodelight_Website.Helpers.CultureHelper.Dir %>">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Choco Delight</asp:ContentPlaceHolder></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,500&amp;family=El+Messiri:wght@500;600;700&amp;family=Outfit:wght@300;400;500;600&amp;family=Almarai:wght@400;700&amp;display=swap" rel="stylesheet" />
    <link href="<%= Chocodelight_Website.Helpers.CultureHelper.Asset(this, "~/assets/css/site.css") %>" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
    <asp:ScriptManager ID="sm" runat="server" />

    <!-- shared shapes -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="ic-hex" viewBox="0 0 100 100">
        <polygon class="motif" points="50,4 90,27 90,73 50,96 10,73 10,27"/>
        <polygon class="motif" points="50,16 79,33 79,67 50,84 21,67 21,33" opacity=".6"/>
      </symbol>
      <symbol id="ic-sprig" viewBox="0 0 100 100">
        <line class="motif" x1="72" y1="82" x2="55" y2="30"/><circle class="motif" cx="55" cy="30" r="3"/>
        <line class="motif" x1="62" y1="60" x2="48" y2="46"/><circle class="motif" cx="48" cy="46" r="3"/>
        <line class="motif" x1="66" y1="72" x2="80" y2="60"/><circle class="motif" cx="80" cy="60" r="3"/>
      </symbol>
      <symbol id="ic-truck" viewBox="0 0 24 24">
        <rect x="1.5" y="7" width="12" height="9"/><path d="M13.5 10h4l4 3.5V16h-8z"/>
        <circle cx="6" cy="18.5" r="1.7"/><circle cx="17" cy="18.5" r="1.7"/>
      </symbol>
      <symbol id="ic-cash" viewBox="0 0 24 24">
        <rect x="2" y="6" width="20" height="12" rx="1"/><circle cx="12" cy="12" r="3"/>
        <line x1="5" y1="9" x2="5" y2="9.01"/><line x1="19" y1="15" x2="19" y2="15.01"/>
      </symbol>
      <symbol id="ic-leaf" viewBox="0 0 24 24"><path d="M4 20c0-9 6-15 16-16-1 10-7 16-16 16z"/><line x1="4" y1="20" x2="14" y2="10"/></symbol>
      <symbol id="ic-card" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="1"/><path d="M7 15c1.5-2 3-2 5 0M12 9h6M12 12h4"/></symbol>
      <symbol id="ic-cart" viewBox="0 0 24 24"><circle cx="9" cy="20" r="1.2"/><circle cx="18" cy="20" r="1.2"/><path d="M1.5 2.5h2.5l2.9 13.2h11.7l2.4-9.2H6.2"/></symbol>
      <symbol id="ic-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.6"/><path d="M4.5 20c1.6-4 5-5.6 7.5-5.6s5.9 1.6 7.5 5.6"/></symbol>
      <symbol id="ic-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
      <symbol id="ic-phone" viewBox="0 0 24 24"><path d="M4 3h4l1.5 5-2.3 1.7a13 13 0 0 0 7.1 7.1L16.3 14.5 21 16v4a2 2 0 0 1-2.2 2C10.3 21.4 2.6 13.7 2 5.2A2 2 0 0 1 4 3z"/></symbol>
      <symbol id="ic-ig" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1"/></symbol>
      <symbol id="ic-fb" viewBox="0 0 24 24"><path d="M14.5 21v-8h2.7l.4-3.2h-3.1V7.7c0-.9.3-1.6 1.7-1.6h1.6V3.2C17.5 3.1 16.3 3 15 3c-2.7 0-4.6 1.7-4.6 4.7v2.1H7.7v3.2h2.7v8z"/></symbol>
      <symbol id="ic-wa" viewBox="0 0 24 24"><path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.6-1.3A9 9 0 1 0 12 3z"/><path d="M8.3 8.6c.2-.5.5-.5.8-.5h.6c.2 0 .5 0 .7.5l.8 1.9c.1.3 0 .5-.1.7l-.6.7c-.1.2-.2.4 0 .7.6 1 1.5 1.9 2.6 2.4.3.1.5.1.6-.1l.6-.8c.2-.2.4-.3.7-.1l1.8.9c.3.1.4.3.4.6-.1 1-1.5 1.7-2.4 1.7-2 0-5.5-2.1-6.6-6-.3-1 .1-1.9.3-2.4z"/></symbol>
      <symbol id="ic-star" viewBox="0 0 24 24"><polygon points="12,2 14.9,9.1 22,9.4 16.5,14.1 18.4,21.5 12,17.4 5.6,21.5 7.5,14.1 2,9.4 9.1,9.1"/></symbol>
      <symbol id="ic-tag" viewBox="0 0 24 24"><path d="M12 2 2 12l10 10 10-10z"/><circle cx="12" cy="7" r="1.3"/></symbol>
      <symbol id="ic-pencil" viewBox="0 0 24 24"><path d="M4 20l1-4.5L15.5 5 19 8.5 8.5 19 4 20z"/><path d="M13 7l4 4"/></symbol>
      <symbol id="ic-empty" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4.3-4.3"/></symbol>
      <symbol id="ic-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
      <symbol id="ic-minus" viewBox="0 0 24 24"><path d="M5 12h14"/></symbol>
      <symbol id="ic-close" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></symbol>
      <symbol id="ic-arrow-back" viewBox="0 0 24 24"><path d="M19 12H5M11 6l-6 6 6 6"/></symbol>
      <symbol id="ic-check" viewBox="0 0 24 24"><path d="M4 12l5 5L20 6"/></symbol>
      <symbol id="ic-mail" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M3 6l9 6 9-6"/></symbol>
      <symbol id="ic-lock" viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="10" rx="1"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/></symbol>
      <symbol id="ic-eye" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></symbol>
      <symbol id="ic-eye-off" viewBox="0 0 24 24"><path d="M3 3l18 18"/><path d="M10.6 10.6a3 3 0 0 0 4.24 4.24"/><path d="M6.4 6.7C4 8.3 2 12 2 12s4 7 10 7c1.8 0 3.4-.4 4.8-1.2M17.9 17.9C19.9 16.4 22 12 22 12s-1.6-2.8-4.3-4.8"/><path d="M9.9 5.2A10.6 10.6 0 0 1 12 5c6 0 10 7 10 7"/></symbol>
      <symbol id="ic-pin" viewBox="0 0 24 24"><path d="M12 21s7-6.6 7-12a7 7 0 1 0-14 0c0 5.4 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/></symbol>
      <symbol id="ic-gift" viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="4"/><rect x="4.5" y="12" width="15" height="9"/><path d="M12 8v13M12 8S9 8 8 6.5 9 3 12 8zM12 8s3 0 4-1.5S15 3 12 8z"/></symbol>
    </svg>

    <header class="site-header">
      <div class="wrap nav">
        <a href="<%= ResolveUrl("~/Default.aspx") %>" class="brand" aria-label="Choco Delight">
          <img class="brand-mark" src="<%= Chocodelight_Website.Helpers.CultureHelper.Asset(this, "~/assets/img/logo.jpg") %>" alt="" width="40" height="40" />
          <span>
            <span class="brand-word">Choco Delight</span>
            <span class="brand-tag"><%= T("تذوق طعم السعادة", "Taste Happiness") %></span>
          </span>
        </a>

        <nav aria-label="Main">
          <ul class="nav-links">
            <li><a href="<%= ResolveUrl("~/Default.aspx") %>"><%= T("الرئيسية", "Home") %></a></li>
            <li><a href="<%= ResolveUrl("~/About.aspx") %>"><%= T("من نحن", "About Us") %></a></li>
            <li><a href="<%= ResolveUrl("~/Menu.aspx") %>"><%= T("المنيو", "Menu") %></a></li>
            <li><a href="<%= ResolveUrl("~/Contact.aspx") %>"><%= T("اتصل بينا", "Contact") %></a></li>
          </ul>
        </nav>

        <div class="nav-actions">
          <div class="lang-toggle" role="group" aria-label="Language">
            <a href="<%= LangSwitchUrl("ar") %>" class="<%= Chocodelight_Website.Helpers.CultureHelper.IsArabic ? "is-on" : "" %>">AR</a>
            <a href="<%= LangSwitchUrl("en") %>" class="<%= Chocodelight_Website.Helpers.CultureHelper.IsEnglish ? "is-on" : "" %>">EN</a>
          </div>
          <a class="icon-btn" href="<%= AccountUrl() %>" aria-label="<%= T("حسابي","Account") %>">
            <svg viewBox="0 0 24 24"><use href="#ic-user"/></svg>
          </a>
          <a class="icon-btn" href="<%= ResolveUrl("~/Cart.aspx") %>" aria-label="<%= T("السلة","Cart") %>">
            <svg viewBox="0 0 24 24"><use href="#ic-cart"/></svg>
            <asp:Literal ID="litCartCount" runat="server" />
          </a>
        </div>
      </div>
    </header>

    <main>
      <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

    <footer class="site-footer" id="contact">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <span class="footer-brand-word">Choco Delight</span>
            <p class="footer-tag"><%= T("شوكولاتة يدوية الصنع، توصيل لباب بيتك، والدفع عند الاستلام.", "Handmade chocolate, delivered to your door, pay on arrival.") %></p>
            <div class="footer-social">
              <a href="https://www.instagram.com/chocoldelight22" target="_blank" rel="noopener" class="social-icon" aria-label="Instagram"><svg viewBox="0 0 24 24"><use href="#ic-ig"/></svg></a>
              <a href="https://www.facebook.com/ChocoDelight22/" target="_blank" rel="noopener" class="social-icon" aria-label="Facebook"><svg viewBox="0 0 24 24"><use href="#ic-fb"/></svg></a>
              <a href="https://wa.me/201202729855" target="_blank" rel="noopener" class="social-icon" aria-label="WhatsApp"><svg viewBox="0 0 24 24"><use href="#ic-wa"/></svg></a>
            </div>
          </div>
          <div class="footer-col">
            <span class="footer-col-title"><%= T("روابط سريعة","Quick Links") %></span>
            <ul>
              <li><a href="<%= ResolveUrl("~/Default.aspx") %>"><%= T("الرئيسية","Home") %></a></li>
              <li><a href="<%= ResolveUrl("~/About.aspx") %>"><%= T("من نحن","About Us") %></a></li>
              <li><a href="<%= ResolveUrl("~/Menu.aspx") %>"><%= T("المنيو","Menu") %></a></li>
              <li><a href="<%= ResolveUrl("~/Contact.aspx") %>"><%= T("اتصل بينا","Contact") %></a></li>
            </ul>
          </div>
          <div class="footer-col">
            <span class="footer-col-title"><%= T("حسابي","Account") %></span>
            <ul>
              <li><a href="<%= ResolveUrl("~/Account/Login.aspx") %>"><%= T("تسجيل الدخول","Sign In") %></a></li>
              <li><a href="<%= ResolveUrl("~/Account/MyAccount.aspx") %>"><%= T("طلباتي","My Orders") %></a></li>
              <li><a href="<%= ResolveUrl("~/Cart.aspx") %>"><%= T("السلة","Cart") %></a></li>
              <li><a href="<%= ResolveUrl("~/Policy.aspx") %>"><%= T("سياسة الاستخدام","Terms") %></a></li>
            </ul>
          </div>
          <div class="footer-col">
            <span class="footer-col-title"><%= T("تواصل معنا","Get in Touch") %></span>
            <ul>
              <li class="footer-phone"><svg viewBox="0 0 24 24"><use href="#ic-phone"/></svg><span>+20 120 272 9855</span></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span><%= T("© 2026 Choco Delight. جميع الحقوق محفوظة.","© 2026 Choco Delight. All rights reserved.") %></span>
          <div class="footer-legal">
            <a href="<%= ResolveUrl("~/Policy.aspx") %>"><%= T("سياسة الاستخدام والخصوصية","Terms &amp; Privacy") %></a>
          </div>
        </div>
      </div>
    </footer>

    <script src="<%= Chocodelight_Website.Helpers.CultureHelper.Asset(this, "~/assets/js/site.js") %>"></script>
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />
    </form>
</body>
</html>
