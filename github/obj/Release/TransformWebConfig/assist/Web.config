<?xml version="1.0" encoding="utf-8"?>
<!--
  Applied when the project is published with the "Release" configuration.
  Fill in the real values before deploying.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <connectionStrings>
    <add name="Chocodelight"
         connectionString="Server=PROD_SERVER;Database=Chocodelight;User Id=PROD_USER;Password=PROD_PASSWORD;Encrypt=True"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>

  <appSettings>
    <add key="DefaultAdminPassword" value="SET-A-STRONG-PASSWORD"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="MailFrom" value="no-reply@yourdomain.com"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="MailFromName" value="Choco Delight"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="ContactRecipient" value="orders@yourdomain.com"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>

  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors mode="On" xdt:Transform="SetAttributes(mode)" />
    <httpCookies requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" />
    <authentication>
      <forms requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" />
    </authentication>
  </system.web>

  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network" xdt:Transform="SetAttributes(deliveryMethod)">
        <network host="smtp.yourprovider.com" port="587" enableSsl="true"
                 userName="SMTP_USER" password="SMTP_PASSWORD"
                 xdt:Transform="Insert" />
      </smtp>
    </mailSettings>
  </system.net>

  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains"
             xdt:Transform="Insert" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

</configuration>
